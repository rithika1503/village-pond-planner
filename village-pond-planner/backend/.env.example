# Village Pond Planner — Backend Environment Variables
# Copy this file to .env and fill in your values.

# Database (PostGIS)
DATABASE_URL=postgresql+asyncpg://pond_user:pond_pass@localhost:5432/village_pond
DATABASE_SYNC_URL=postgresql+psycopg2://pond_user:pond_pass@localhost:5432/village_pond

# Debugging
DEBUG=false

# DEM cache directory (relative to backend/)
DEM_CACHE_DIR=./dem_cache

# Suitability weights — must sum to 1.0
WEIGHT_TERRAIN=0.30
WEIGHT_CATCHMENT=0.30
WEIGHT_RAINFALL=0.20
WEIGHT_LAND=0.20
